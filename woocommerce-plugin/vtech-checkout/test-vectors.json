        "timestamp": 1700001234,
        "items": [
          {
            "wooProductId": "202",
            "wooVariantId": "55",
            "qty": 1
          }
        ],
        "address": {
          "addressLine1": "456 Park Ave",
          "city": "Mumbai",
          "country": "IN",
          "fullName": "Jane Doe",
          "phone": "8888888888",
          "state": "Maharashtra",
          "zipCode": "400001"
