{
  "_comment": "Shared HMAC test vectors. Both PHP and Node.js must produce identical canonical strings for each vector. The 'canonical' field is the expected canonical string produced by both implementations.",
  "testSecret": "vtech-shared-test-vector-secret-NOT-FOR-PRODUCTION",
  "vectors": [
    {
      "id": "v1-simple-product",
      "description": "Simple product (no variant), one item, standard address",
      "input": {
        "method": "POST",
        "path": "/api/woo/handoff",
        "externalSource": "woo_vegetablecuttingmachine",
        "nonce": "abc123def45678",
        "timestamp": 1700000000,
        "items": [
          {
            "wooProductId": "101",
            "wooVariantId": null,
            "qty": 2
          }
        ],
        "address": {
          "fullName": "Test User",
          "phone": "9999999999",
          "addressLine1": "123 Main St",
          "city": "Chennai",
          "state": "Tamil Nadu",
          "zipCode": "600001",
          "country": "IN"
        }
      },
      "expectedCanonical": "POST\n/api/woo/handoff\nwoo_vegetablecuttingmachine\nabc123def45678\n1700000000\n[{\"qty\":2,\"wooProductId\":\"101\",\"wooVariantId\":null}]\n{\"addressLine1\":\"123 Main St\",\"city\":\"Chennai\",\"country\":\"IN\",\"fullName\":\"Test User\",\"phone\":\"9999999999\",\"state\":\"Tamil Nadu\",\"zipCode\":\"600001\"}",
      "expectedSignature": "1b598b9eae99c83c2e287fa77ad30a01c2cc0acb94bf325b6e149630b80b9ac7"
    },
    {
      "id": "v2-variable-product",
      "description": "Variable product with variant ID",
      "input": {
        "method": "POST",
        "path": "/api/woo/handoff",
        "externalSource": "woo_styleyourlyf",
